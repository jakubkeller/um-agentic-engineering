#!/usr/bin/env bash
# um-agentic-engineering Kiro toolkit CLI.
#
# Usage:
#   agentic-eng install     First-time setup: install the latest approved release.
#   agentic-eng update      Explicitly check for and activate a newer approved release.
#   agentic-eng version     Show installed version and (if reachable) the latest available.
#   agentic-eng rollback    Restore the previously installed release. Works offline.
#   agentic-eng uninstall   Remove everything agentic-eng has installed.
#   agentic-eng --help
#
# First run (from a clone of um-agentic-engineering):
#   git clone git@github.com:jakubkeller/um-agentic-engineering.git
#   cd um-agentic-engineering
#   ./agentic-eng install
#
# See docs/SETUP.md for prerequisites, platform support, and verification.
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# AGENTIC_TOOLKIT_HOME exists only so scripts/smoke-test.sh can exercise this
# tool against a throwaway directory instead of a real $HOME. Kiro itself
# always reads from the engineer's actual home directory, so this variable
# has no effect on what Kiro discovers — do not rely on it for a real install.
INSTALL_HOME="${AGENTIC_TOOLKIT_HOME:-$HOME}"
KIRO_DIR="$INSTALL_HOME/.kiro"
SKILLS_DIR="$KIRO_DIR/skills"
STEERING_DIR="$KIRO_DIR/steering"
STATE_DIR="$KIRO_DIR/.um-agentic-engineering"
BIN_DIR="$STATE_DIR/bin"
SOURCE_DIR="$STATE_DIR/source"
RELEASES_DIR="$STATE_DIR/releases"
CURRENT_LINK="$STATE_DIR/current"
PREVIOUS_LINK="$STATE_DIR/previous"
MANIFEST="$STATE_DIR/install-manifest.txt"
STATUS_STEERING="$STEERING_DIR/um-agentic-engineering-status.md"

info() { printf '==> %s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

CLEANUP_DIR=""
cleanup() {
  if [ -n "$CLEANUP_DIR" ]; then
    rm -rf "$CLEANUP_DIR" 2>/dev/null
  fi
  return 0
}
trap cleanup EXIT

show_help() {
  cat <<'EOF'
agentic-eng — um-agentic-engineering shared Kiro toolkit

Usage:
  agentic-eng install     Install the latest approved release (first-time setup).
  agentic-eng update      Check for and activate a newer approved release.
  agentic-eng version     Show installed version and (if reachable) the latest available.
  agentic-eng rollback    Restore the previously installed release (works offline).
  agentic-eng uninstall   Remove everything agentic-eng has installed.
  agentic-eng --help      Show this help.

First run (from a clone of um-agentic-engineering):
  git clone git@github.com:jakubkeller/um-agentic-engineering.git
  cd um-agentic-engineering
  ./agentic-eng install

That also copies agentic-eng onto your machine so later commands work from
anywhere once it's on your PATH (install/update print the exact line to add
if it isn't already).

State: ~/.kiro/.um-agentic-engineering/
EOF
}

check_prereqs() {
  command -v git >/dev/null 2>&1 || fail "git is required by agentic-eng (to resolve and fetch approved releases) but was not found on PATH."
  [ -d "$INSTALL_HOME" ] || fail "Install target directory does not exist: $INSTALL_HOME"
  [ -w "$INSTALL_HOME" ] || fail "No write permission to $INSTALL_HOME. Fix permissions on your home directory and re-run."
  case "$(uname -s)" in
    Darwin|Linux) ;;
    *) warn "agentic-eng has only been verified on macOS and Linux (see docs/SETUP.md). Continuing anyway on $(uname -s)." ;;
  esac
  if [ "$(uname -s)" = "Darwin" ] && [ ! -d "/Applications/Kiro.app" ] && ! command -v kiro >/dev/null 2>&1; then
    warn "Kiro.app was not found in /Applications and no 'kiro' command is on PATH. The toolkit will still be installed to $KIRO_DIR — Kiro will pick it up once it is installed."
  fi
}

digest_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    sha256sum "$1" | awk '{print $1}'
  fi
}

digest_dir() {
  local dir="$1" f list=""
  while IFS= read -r f; do
    list="${list}$(digest_file "$dir/$f")  $f
"
  done < <(cd "$dir" && find . -type f | sed 's#^\./##' | LC_ALL=C sort)
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$list" | shasum -a 256 | awk '{print $1}'
  else
    printf '%s' "$list" | sha256sum | awk '{print $1}'
  fi
}

# Lines of a manifest/metadata file formatted "key: value" (manifest comments
# are "# key: value"; release-metadata.txt lines have no leading "# ").
read_field() {
  local file="$1" key="$2" prefix="${3:-}"
  [ -f "$file" ] || return 1
  local line
  line="$(grep "^${prefix}${key}: " "$file" 2>/dev/null | head -n1)"
  [ -n "$line" ] || return 1
  printf '%s' "$line" | sed "s/^${prefix}${key}: //"
}

manifest_field() { read_field "$MANIFEST" "$1" '# '; }
release_field() { read_field "$1" "$2"; }

# Lines of the manifest that aren't comments/blank are "<category>/<name>"
# relative paths this tool previously wrote under $KIRO_DIR.
read_manifest_entries() {
  if [ -f "$MANIFEST" ]; then
    grep -v '^[[:space:]]*#' "$MANIFEST" | grep -v '^[[:space:]]*$' || true
  fi
}

entry_in_list() {
  local needle="$1" entry
  while IFS= read -r entry; do
    [ "$entry" = "$needle" ] && return 0
  done <<<"$2"
  return 1
}

# --- release source: a persistent, tool-managed clone used only to resolve
# tags and extract release content. Never checks out/mutates HEAD of either
# this clone or the engineer's own working clone. ---

ensure_source_clone() {
  if [ -d "$SOURCE_DIR/.git" ]; then
    return 0
  fi
  [ -d "$SOURCE_DIR" ] && [ ! -d "$SOURCE_DIR/.git" ] && rm -rf "$SOURCE_DIR"

  local origin_url
  origin_url="$(git -C "$SCRIPT_DIR" remote get-url origin 2>/dev/null)"
  [ -n "$origin_url" ] || return 1

  # Don't leave an empty ~/.kiro/ behind if the clone below fails — only
  # remove what this call itself created.
  local created_kiro_dir=0 created_state_dir=0
  [ -d "$KIRO_DIR" ] || created_kiro_dir=1
  [ -d "$STATE_DIR" ] || created_state_dir=1
  mkdir -p "$STATE_DIR"

  if git clone --quiet "$origin_url" "$SOURCE_DIR" >/dev/null 2>&1; then
    return 0
  fi

  rm -rf "$SOURCE_DIR"
  [ "$created_state_dir" -eq 1 ] && rmdir "$STATE_DIR" 2>/dev/null
  [ "$created_kiro_dir" -eq 1 ] && rmdir "$KIRO_DIR" 2>/dev/null
  return 1
}

resolve_latest_tag() {
  git -C "$SOURCE_DIR" fetch --quiet --tags origin || fail "Could not fetch tags from the release source. Check network access and retry."
  local tag
  tag="$(git -C "$SOURCE_DIR" tag --list 'v*' --sort=-version:refname | head -n1)"
  [ -n "$tag" ] || fail "No approved release tags found yet (expected tags like v1.0.0). Ask a maintainer to publish one."
  printf '%s' "$tag"
}

stage_release() {
  local tag="$1" staging_dir="$2"
  mkdir -p "$staging_dir"
  git -C "$SOURCE_DIR" archive "$tag" -- toolkit VERSION 2>/dev/null | tar -x -C "$staging_dir" \
    || fail "Could not extract release $tag from the local release-tracking clone."
}

validate_release() {
  local dir="$1" expected_version="$2"
  if [ ! -f "$dir/VERSION" ]; then
    warn "Staged release is missing a VERSION file."
    return 1
  fi
  local v
  v="$(tr -d '[:space:]' < "$dir/VERSION")"
  if [ "$v" != "$expected_version" ]; then
    warn "Staged release VERSION ($v) does not match its tag's expected version ($expected_version)."
    return 1
  fi
  if [ ! -d "$dir/toolkit/skills" ]; then
    warn "Staged release has no toolkit/skills directory."
    return 1
  fi
  local skill_dir name frontmatter_name
  while IFS= read -r -d '' skill_dir; do
    name="$(basename "$skill_dir")"
    if [ ! -f "$skill_dir/SKILL.md" ]; then
      warn "Staged skill '$name' has no SKILL.md."
      return 1
    fi
    frontmatter_name="$(awk -F': *' '/^name:/{print $2; exit}' "$skill_dir/SKILL.md")"
    if [ "$frontmatter_name" != "$name" ]; then
      warn "Staged skill '$name': SKILL.md frontmatter name ('$frontmatter_name') does not match its folder."
      return 1
    fi
    if ! grep -q '^description:[[:space:]]*[^[:space:]]' "$skill_dir/SKILL.md"; then
      warn "Staged skill '$name': SKILL.md has no non-empty description."
      return 1
    fi
  done < <(find "$dir/toolkit/skills" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)

  local f
  while IFS= read -r -d '' f; do
    if head -n1 "$f" | grep -q '^---$'; then
      if ! awk 'NR>1 && /^---$/{found=1; exit} END{exit !found}' "$f"; then
        warn "Staged steering file '$(basename "$f")' has an unterminated frontmatter block."
        return 1
      fi
    fi
  done < <(find "$dir/toolkit/steering" -mindepth 1 -maxdepth 1 -type f -name '*.md' -print0 2>/dev/null)

  return 0
}

write_status_steering() {
  local version="$1" commit="$2"
  mkdir -p "$STEERING_DIR"
  cat > "$STATUS_STEERING" <<EOF
---
inclusion: always
---

um-agentic-engineering toolkit installed version: $version (commit $commit), last updated $(date -u +%Y-%m-%dT%H:%M:%SZ).
EOF
}

# Activates the toolkit/ content found under $1 (a staging dir fresh from
# stage_release, or a cached release dir from $RELEASES_DIR) into the live
# ~/.kiro/skills and ~/.kiro/steering, building each artifact at a temp
# sibling path and renaming it into place so a crash mid-copy can't leave a
# half-written skill live. Never touches a same-named artifact it did not
# itself install. Writes the manifest.
activate_release() {
  local source_dir="$1" version="$2" commit="$3" tag="$4"
  mkdir -p "$SKILLS_DIR" "$STEERING_DIR" "$STATE_DIR"

  local prev_entries new_entries
  prev_entries="$(read_manifest_entries)"
  new_entries=""

  local dir name dest tmp rel
  while IFS= read -r -d '' dir; do
    name="$(basename "$dir")"
    rel="skills/$name"
    dest="$SKILLS_DIR/$name"
    if [ -e "$dest" ] && ! entry_in_list "$rel" "$prev_entries"; then
      warn "Skipping $rel: $dest already exists and was not installed by this toolkit."
      continue
    fi
    tmp="$SKILLS_DIR/.staging-$name.$$"
    rm -rf "$tmp"
    mkdir -p "$tmp"
    cp -R "$dir/." "$tmp/"
    rm -rf "$dest"
    mv "$tmp" "$dest"
    new_entries="${new_entries}${rel}
"
    info "Installed skill: $name"
  done < <(find "$source_dir/toolkit/skills" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)

  local file base
  while IFS= read -r -d '' file; do
    base="$(basename "$file")"
    rel="steering/$base"
    dest="$STEERING_DIR/$base"
    if [ -e "$dest" ] && ! entry_in_list "$rel" "$prev_entries"; then
      warn "Skipping $rel: $dest already exists and was not installed by this toolkit."
      continue
    fi
    tmp="$STEERING_DIR/.staging-$base.$$"
    cp "$file" "$tmp"
    mv "$tmp" "$dest"
    new_entries="${new_entries}${rel}
"
    info "Installed steering file: $base"
  done < <(find "$source_dir/toolkit/steering" -mindepth 1 -maxdepth 1 -type f -name '*.md' -print0 2>/dev/null)

  if [ -n "$prev_entries" ]; then
    local entry
    while IFS= read -r entry; do
      [ -z "$entry" ] && continue
      if ! entry_in_list "$entry" "$new_entries"; then
        rm -rf "${KIRO_DIR:?}/${entry:?}"
        info "Removed stale artifact from a previous release: $entry"
      fi
    done <<<"$prev_entries"
  fi

  write_status_steering "$version" "$commit"

  {
    printf '# um-agentic-engineering toolkit install manifest\n'
    printf '# version: %s\n' "$version"
    printf '# tag: %s\n' "$tag"
    printf '# commit: %s\n' "$commit"
    printf '# installed_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s' "$new_entries"
  } > "$MANIFEST"
}

# Caches the just-activated release's toolkit/ content under $RELEASES_DIR,
# atomically swaps the current/previous symlinks, and prunes anything else.
cache_release() {
  local staged_dir="$1" version="$2" commit="$3" tag="$4"
  local release_dir="$RELEASES_DIR/$version"
  mkdir -p "$RELEASES_DIR"
  rm -rf "$release_dir"
  mkdir -p "$release_dir"
  cp -R "$staged_dir/toolkit" "$release_dir/toolkit"
  cp "$staged_dir/VERSION" "$release_dir/VERSION"

  local fp
  fp="$(digest_dir "$release_dir/toolkit")"
  {
    printf 'version: %s\n' "$version"
    printf 'tag: %s\n' "$tag"
    printf 'commit: %s\n' "$commit"
    printf 'integrity_sha256: %s\n' "$fp"
    printf 'compatibility: none specified\n'
    printf 'cached_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$release_dir/release-metadata.txt"

  local prev_current=""
  [ -L "$CURRENT_LINK" ] && prev_current="$(readlink "$CURRENT_LINK")"
  ln -sfn "$release_dir" "$CURRENT_LINK"
  if [ -n "$prev_current" ] && [ "$prev_current" != "$release_dir" ]; then
    ln -sfn "$prev_current" "$PREVIOUS_LINK"
  fi

  local keep_current="" keep_previous=""
  [ -L "$CURRENT_LINK" ] && keep_current="$(basename "$(readlink "$CURRENT_LINK")")"
  [ -L "$PREVIOUS_LINK" ] && keep_previous="$(basename "$(readlink "$PREVIOUS_LINK")")"

  local entry entry_base
  while IFS= read -r -d '' entry; do
    entry_base="$(basename "$entry")"
    if [ "$entry_base" != "$keep_current" ] && [ "$entry_base" != "$keep_previous" ]; then
      rm -rf "$entry"
    fi
  done < <(find "$RELEASES_DIR" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
}

install_self_to_bin() {
  mkdir -p "$BIN_DIR"
  local self="$SCRIPT_DIR/agentic-eng" dest="$BIN_DIR/agentic-eng"
  if [ -f "$self" ] && [ "$self" != "$dest" ]; then
    cp "$self" "$dest" && chmod +x "$dest"
  elif [ ! -f "$dest" ] && [ -f "$0" ]; then
    cp "$0" "$dest" 2>/dev/null && chmod +x "$dest" || true
  fi
}

print_path_hint() {
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *)
      info "Add $BIN_DIR to your PATH to run 'agentic-eng' from anywhere, e.g. add this line to your shell profile (~/.zshrc or ~/.bashrc):"
      info "  export PATH=\"$BIN_DIR:\$PATH\""
      ;;
  esac
}

do_install_or_update() {
  check_prereqs
  ensure_source_clone || fail "Could not set up or reach the release source. Run this from inside a clone of um-agentic-engineering with network access, then retry."

  local tag version commit installed_version
  tag="$(resolve_latest_tag)"
  version="${tag#v}"
  commit="$(git -C "$SOURCE_DIR" rev-parse --short "$tag")"
  installed_version="$(manifest_field version 2>/dev/null || true)"

  if [ -n "$installed_version" ] && [ "$installed_version" = "$version" ]; then
    info "Already up to date (installed: $version)."
    return 0
  fi

  local staging_dir
  staging_dir="$(mktemp -d "${TMPDIR:-/tmp}/agentic-eng-staging.XXXXXX")"
  CLEANUP_DIR="$staging_dir"

  stage_release "$tag" "$staging_dir"
  if ! validate_release "$staging_dir" "$version"; then
    fail "Release $tag failed validation and was rejected. Your current installation (${installed_version:-none}) is unchanged."
  fi

  activate_release "$staging_dir" "$version" "$commit" "$tag"
  cache_release "$staging_dir" "$version" "$commit" "$tag"
  install_self_to_bin

  info "Installed version $version ($tag, commit $commit)."
  print_path_hint
  info "Restart Kiro (or reload its window) to pick up the change."
}

do_version() {
  local installed_version installed_tag installed_commit installed_at
  installed_version="$(manifest_field version 2>/dev/null || true)"
  if [ -z "$installed_version" ]; then
    info "um-agentic-engineering toolkit is not installed. Run 'agentic-eng install'."
    return 0
  fi
  installed_tag="$(manifest_field tag 2>/dev/null || true)"
  installed_commit="$(manifest_field commit 2>/dev/null || true)"
  installed_at="$(manifest_field installed_at 2>/dev/null || true)"
  info "Installed: $installed_version (tag ${installed_tag:-unknown}, commit ${installed_commit:-unknown}, installed ${installed_at:-unknown})"

  if ensure_source_clone && git -C "$SOURCE_DIR" fetch --quiet --tags origin 2>/dev/null; then
    local latest_tag latest_version
    latest_tag="$(git -C "$SOURCE_DIR" tag --list 'v*' --sort=-version:refname | head -n1)"
    if [ -z "$latest_tag" ]; then
      info "No approved release tags are published yet."
    else
      latest_version="${latest_tag#v}"
      if [ "$latest_version" = "$installed_version" ]; then
        info "Up to date."
      else
        info "Update available: $installed_version -> $latest_version (run 'agentic-eng update')."
      fi
    fi
  else
    warn "Could not check for updates (offline or release source unreachable). Last known installed version: $installed_version"
  fi
}

do_rollback() {
  [ -L "$PREVIOUS_LINK" ] || fail "No previous release available to roll back to."
  local prev_target
  prev_target="$(readlink "$PREVIOUS_LINK")"
  [ -d "$prev_target" ] || fail "Previous release cache at $prev_target is missing. Cannot roll back."

  local meta="$prev_target/release-metadata.txt"
  [ -f "$meta" ] || fail "Previous release metadata missing. Cannot safely roll back."

  local version tag commit expected_fp actual_fp
  version="$(release_field "$meta" version)"
  tag="$(release_field "$meta" tag)"
  commit="$(release_field "$meta" commit)"
  expected_fp="$(release_field "$meta" integrity_sha256)"
  actual_fp="$(digest_dir "$prev_target/toolkit")"
  if [ "$actual_fp" != "$expected_fp" ]; then
    fail "Previous release cache failed an integrity check. Refusing to roll back to possibly-corrupted content."
  fi

  activate_release "$prev_target" "$version" "$commit" "$tag"

  local cur_target=""
  [ -L "$CURRENT_LINK" ] && cur_target="$(readlink "$CURRENT_LINK")"
  ln -sfn "$prev_target" "$CURRENT_LINK"
  [ -n "$cur_target" ] && ln -sfn "$cur_target" "$PREVIOUS_LINK"

  info "Rolled back to version $version ($tag)."
}

do_uninstall() {
  if [ ! -f "$MANIFEST" ]; then
    info "Nothing to uninstall: no manifest found at $MANIFEST."
    return 0
  fi
  local entries entry
  entries="$(read_manifest_entries)"
  while IFS= read -r entry; do
    [ -z "$entry" ] && continue
    rm -rf "${KIRO_DIR:?}/${entry:?}"
    info "Removed: $entry"
  done <<<"$entries"
  rm -f "$STATUS_STEERING"
  rm -rf "$STATE_DIR"
  info "Uninstall complete."
}

ACTION="${1:-}"
case "$ACTION" in
  install) do_install_or_update ;;
  update) do_install_or_update ;;
  version) do_version ;;
  rollback) do_rollback ;;
  uninstall) do_uninstall ;;
  --help|-h|help|"") show_help ;;
  *) fail "Unknown command: $ACTION (see --help)" ;;
esac
